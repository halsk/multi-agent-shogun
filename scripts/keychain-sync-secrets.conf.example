# ~/.config/keychain-sync/secrets.conf — Keychain sync configuration
#
# Format: <keychain-service-name>  <op-item-name>  [op-vault]  [op-field]
#
# Place this file at: ~/.config/keychain-sync/secrets.conf
# Or set: export KEYCHAIN_SYNC_CONFIG=/path/to/secrets.conf
#
# Rotation procedure:
#   1. Update the value in 1Password
#   2. Re-run: bash scripts/sync-secrets-to-keychain.sh

# ── geonic-ops secrets ──────────────────────────────────────────────────────
lawsy-api-key  lawsy-civic-intelligence-rag  geonic-ops  LAWSY_API_KEY

# ── ai-worker stack (n8n + postgres + cloudflared + gitops) ─────────────────
# Run migrate-secrets-to-op.sh on WSL2 first to populate the ai-worker vault.
# op item list --vault ai-worker should show 12 items before running sync.

# ★ 温存必須 (rotate 禁止): n8n credential 復号鍵
ai-worker-n8n-encryption-key    ai-worker-N8N_ENCRYPTION_KEY    ai-worker  password

# postgres 接続パスワード (postgres service + n8n DB_POSTGRESDB_PASSWORD 共通)
ai-worker-postgres-password     ai-worker-POSTGRES_PASSWORD     ai-worker  password

# Cloudflare Tunnel token
ai-worker-cloudflare-tunnel-token  ai-worker-CLOUDFLARE_TUNNEL_TOKEN  ai-worker  password

# gitops / Obsidian Vault sync token
ai-worker-pull-token            ai-worker-PULL_TOKEN            ai-worker  password

# Slack
ai-worker-slack-bot-token       ai-worker-SLACK_BOT_TOKEN       ai-worker  password
ai-worker-slack-signing-secret  ai-worker-SLACK_SIGNING_SECRET  ai-worker  password

# Notion
ai-worker-notion-token          ai-worker-NOTION_TOKEN          ai-worker  password

# Board
ai-worker-board-api-key         ai-worker-BOARD_API_KEY         ai-worker  password
ai-worker-board-token           ai-worker-BOARD_TOKEN           ai-worker  password

# GitHub
ai-worker-github-token          ai-worker-GITHUB_TOKEN          ai-worker  password

# Anthropic / n8n API
ai-worker-anthropic-api-key     ai-worker-ANTHROPIC_API_KEY     ai-worker  password
ai-worker-n8n-api-key           ai-worker-N8N_API_KEY           ai-worker  password
